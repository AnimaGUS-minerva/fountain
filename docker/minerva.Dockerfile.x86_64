FROM dockerhub.gatineau.credil.org/minerva/minerva_ruby_openssl:v202504 as builder

WORKDIR /app

RUN echo deb http://cacher.sandelman.ca:3142/deb.debian.org/debian bookworm main | tee /etc/apt/sources.list.d/cache.list
RUN apt-get update

RUN apt-get install -y libpq-dev libsqlite3-dev libssl-dev libyaml-dev

RUN gem update --system

# install gems with extensions explicitely so that layers are cached.
RUN gem install -v1.19.2 nokogiri --source=http://rubygems.org && \
    gem install -v1.2.7  eventmachine --source=http://rubygems.org && \
    gem install -v13.0.0  byebug --source=http://rubygems.org && \
    gem install -v1.14.5  io-event --source=http://rubygems.org && \
    gem install -v0.8.2  io-console --source=http://rubygems.org && \
    gem install -v3.2.0  stringio   --source=http://rubygems.org && \
    gem install -v1.8.1  racc --source=http://rubygems.org && \
    gem install -v2.7.5  nio4r --source=http://rubygems.org && \
    gem install -v1.17.3 ffi --source=http://rubygems.org && \
    gem install -v1.6.3  pg --source=http://rubygems.org && \
    gem install -v2.0.1  thin --source=http://rubygems.org && \
    gem install -v0.1.5  websocket-extensions --source=http://rubygems.org && \
    gem install -v0.8.0  websocket-driver     --source=http://rubygems.org && \
    gem install -v0.5.10.1 cbor --source=http://rubygems.org && \
    gem install -v2.6.0  sqlite3 --source=http://rubygems.org && \
    gem install -v2.4.0  sassc   --source=http://rubygems.org && \
    gem install -v3.16.16 oj      --source=http://rubygems.org && \
    gem install -v6.0.2   erb     --source=http://rubygems.org && \
    gem install -v4.0.1   bigdecimal  --source=http://rubygems.org && \
    gem install -v2.19.3  json --source=http://rubygems.org
RUN gem install -v3.5.1 date  --source=http://rubygems.org && \
    gem install -v5.3.1 psych --source=http://rubygems.org

RUN gem install -v6.1.2  passenger --source=http://rubygems.org

RUN ip addr ls || exit 0
RUN ping -c 3 172.30.2.30|| exit 0
RUN ping -c 3 cacher.sandelman.ca || exit 0
RUN apt-get install -y busybox

RUN apt-get install -y apache2 libcurl4-openssl-dev apache2-dev libapr1-dev libaprutil1-dev  zlib1g-dev

RUN /usr/local/bundle/gems/passenger-6.1.2/bin/passenger-install-apache2-module
RUN passenger-config build-native-support

